  "scenarios": [
    {
      "id": "insufficient-evidence",
      "templateId": "template-trusted-client-conversation",
      "title": "Pressure for an immediate answer",
      "type": "ADVISOR-LED",
      "domain": "FARM / MINE",
      "context": "A production incident is affecting order reconciliation for a priority client. The primary service is restored, but downstream validation is incomplete.",
      "participantRole": "Engagement delivery lead",
      "otherRole": "Maya Rao, client operations sponsor",
      "objective": "Respond to a request for a 4pm recovery guarantee without overpromising, while preserving client confidence.",
      "openingSituation": "I need a clear answer. Can you guarantee that we will be fully recovered by 4pm?",
      "dos": [
        "Separate confirmed facts from unresolved evidence",
        "Set a precise checkpoint for the next update"
      ],
      "donts": [
        "Do not treat restored service as proof that downstream reconciliation is complete"
      ],
      "expectedBehaviors": [
        "Acknowledges urgency",
        "Bounds uncertainty",
        "Names required validation",
        "Commits to a timed update"
      ],
      "evaluationCriteria": [
        "Judgement & Restraint",
        "Professional Speech Excellence",
        "Active Listening"
      ],
      "impactEmphasis": [
        "Interpret the Context",
        "Position Your POV",
        "Make Outcomes Visible",
        "Adapt Communication"
      ],
      "possibleConversationDirections": [
        "business impact",
        "evidence ownership",
        "recovery checkpoint",
        "trust challenge"
      ],
      "difficulty": "Developing",
      "status": "published",
      "active": true,
      "version": 1
    },
    {
      "id": "brian-cto",
      "templateId": "template-trusted-client-conversation",
      "title": "Brian — CTO",
      "type": "CLIENT-TRIGGERED",
      "domain": "FARM",
      "context": "Brian has challenged the value of the current solution and needs a credible basis for deciding whether to continue.",
      "participantRole": "Engagement delivery lead",
      "otherRole": "Brian, CTO",
      "objective": "Listen actively, adapt to the CTO's concern, make outcomes visible, and exercise judgement and restraint.",
      "openingSituation": "We have spent six months on this solution and still do not see the business impact. Why should I approve the next phase?",
      "clientStatement": "We have spent six months on this solution and still do not see the business impact. Why should I approve the next phase?",
      "dos": [
        "Acknowledge the concern before responding",
        "Clarify the impact and decision criteria",
        "Make outcomes and trade-offs visible"
      ],
      "donts": [
        "Do not defend the solution without evidence",
        "Do not promise outcomes that have not been demonstrated"
      ],
      "expectedBehaviors": [
        "Listens for the underlying concern",
        "Adapts the response to the business context",
        "Makes a restrained, evidence-based recommendation"
      ],
      "evaluationCriteria": [
        "Active Listening",
        "Adaptive Thinking",
        "Judgement & Restraint",
        "Professional Speech Excellence",
        "Language Accuracy"
      ],
      "impactEmphasis": [
        "Interpret the Context",
        "Make Outcomes Visible",
        "Position Your POV",
        "Restraint"
      ],
      "possibleConversationDirections": [
        "business impact",
        "success criteria",
        "evidence gap",
        "next-phase decision"
      ],
      "difficulty": "Integrated",
      "status": "published",
      "active": true,
      "version": 1
    }

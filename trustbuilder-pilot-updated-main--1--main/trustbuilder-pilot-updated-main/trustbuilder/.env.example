# Server-only configuration. Never copy provider keys into runtime-config.js.
NODE_ENV=development
HOST=0.0.0.0
PORT=4173
TRUSTBUILDER_DATA_DIR=.trustbuilder-data
STORAGE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/trustbuilder
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=
JWT_ISSUER=trustbuilder
JWT_AUDIENCE=trustbuilder-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUDIO_STORAGE_DIR=.trustbuilder-storage/audio
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
ENABLE_AI_TRANSCRIPTION=true
ENABLE_AI_FEEDBACK=true
ENABLE_AUTOMATED_LANGUAGE_ANALYSIS=true
TRANSCRIPTION_PROVIDER=existing
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
MAX_UPLOAD_SIZE=25000000
# Browser endpoints stay same-origin.
TRUSTBUILDER_TRANSCRIPTION_ENDPOINT=/api/ai/transcribe
TRUSTBUILDER_CONVERSATION_ENDPOINT=/api/ai/conversation/next
TRUSTBUILDER_VALIDATION_ENDPOINT=/api/ai/conversation/validate
TRUSTBUILDER_TTS_ENDPOINT=/api/ai/speech
TRUSTBUILDER_EVALUATION_ENDPOINT=/api/ai/evaluate
